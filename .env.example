# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/credit_analyst

# Auth
SECRET_KEY=your-256-bit-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Testing (free) — default ---
# Get a free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- Production (paid) — uncomment when ready ---
# AI_PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Twilio (SMS/WhatsApp) — optional; simulates send when unset
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Frontend
VITE_API_BASE_URL=http://localhost:8000
