# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/credit_analyst

# Auth
SECRET_KEY=your-256-bit-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Single-user free AI (recommended) ---
# 1. Sign up: https://console.groq.com/keys (no credit card)
# 2. Create API key (starts with gsk_)
# 3. Paste below — policy search uses keywords; Groq writes the answer.
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Leave Gemini empty unless you have an AIza key (optional, for embedding search)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- Alternative: Gemini AIza (chat + embeddings) ---
# AI_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...

# --- Production (paid) ---
# AI_PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_MODE=false
